{
    // See https://go.microsoft.com/fwlink/?LinkId=733558
    // for the documentation about the tasks.json format
    "version": "2.0.0",
    "tasks": [
        {
            "label": "configure",
            "type": "shell",
            "command": "cmake -B build -GNinja -DCMAKE_BUILD_TYPE=Debug"
        },
        {
            "label": "build",
            "type": "shell",
            "command": "cmake --build build --parallel 4",
            "dependsOn": "configure"
        }
    ]
}